{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "oneOf": [
        {
            "required": ["create_product.py"],
            "properties": {
                "create_product.py": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "properties": {
                            "firm": { "type": "string" },
                            "code": { "type": "string" },
                            "count": { "type": ["number", "string"] },
                            "price": { "type": ["number", "string"] }
                        },
                        "required": ["firm", "code", "count", "price"],
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        {
            "required": ["insert_state.py"],
            "properties": {
                "insert_state.py": {
                    "type": "object",
                    "properties": {
                        "state": { "type": "string" }
                    },
                    "required": ["state"]
                }
            },
            "additionalProperties": false
        }
    ]
}